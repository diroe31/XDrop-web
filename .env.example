# Copia este archivo como ".env" y llena los valores reales.
# El ".env" real NUNCA se sube a GitHub (ya está en .gitignore).

# --- Base de datos (local con Docker) ---
DATABASE_URL=postgresql://xdrop_user:xdrop_pass_local@localhost:5432/xdrop

# --- Base de datos (Supabase, cuando la conecten) ---
# DATABASE_URL=postgresql://usuario:password@db.xxxxx.supabase.co:5432/postgres

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True

# --- WhatsApp ---
WHATSAPP_NUMERO=51999999999

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
